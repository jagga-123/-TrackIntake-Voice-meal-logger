# --- Django -----------------------------------------------------------------
# Required when DJANGO_DEBUG=false. In debug mode a random per-process key is
# generated, which also means JWTs stop validating after every restart.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# On Render the service hostname is trusted automatically, so this only needs
# your own extra domains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from a browser: the deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed for cross-origin form POSTs such as the Django admin login.
CSRF_TRUSTED_ORIGINS=

# --- Speech to text (faster-whisper) ----------------------------------------
# tiny | base | small | medium | large-v3. "base" balances speed and accuracy on
# CPU; "small" is noticeably better at Hinglish; "tiny" is for tiny instances.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Decoding beam width. 5 is the default; 1 (greedy) is several times cheaper.
WHISPER_BEAM_SIZE=5
# CTranslate2 worker threads. 0 means auto, which is wrong on a throttled
# container because it counts host cores it will never get; pin it to 1 there.
WHISPER_CPU_THREADS=0
# Trim silence before decoding. Costs an extra ONNX model in memory.
WHISPER_VAD_FILTER=true
# Load the model on a background thread when the HTTP server starts. Leave it
# off locally so `runserver` stays instant; turn it on for a deployment.
WARM_MODELS_ON_STARTUP=false

# --- LLM meal parser --------------------------------------------------------
# LLM_PROVIDER=auto uses the first provider with a key: Google Gemini, then
# OpenAI. Set it to gemini | openai to force one. At least one key is required.
LLM_PROVIDER=auto
GEMINI_API_KEY=
# gemini-flash-latest always tracks Google's newest Flash model if this one is retired.
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- Upload limits ----------------------------------------------------------
MAX_AUDIO_BYTES=10485760

# --- Deployment bootstrap ----------------------------------------------------
# When set, `manage.py ensure_superuser` creates or updates this account on boot.
# Leave blank locally and use `manage.py createsuperuser` instead.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
