# --- Django -----------------------------------------------------------------
# Required when DJANGO_DEBUG=false. In debug mode a random per-process key is
# generated, which also means JWTs stop validating after every restart.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Speech to text (faster-whisper) ----------------------------------------
# tiny | base | small | medium | large-v3. "base" balances speed and accuracy on CPU.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM meal parser --------------------------------------------------------
# LLM_PROVIDER=auto uses the first provider with a key: Google Gemini, then
# OpenAI. Set it to gemini | openai to force one. At least one key is required.
LLM_PROVIDER=auto
GEMINI_API_KEY=
# gemini-flash-latest always tracks Google's newest Flash model if this one is retired.
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- Upload limits ----------------------------------------------------------
MAX_AUDIO_BYTES=10485760
